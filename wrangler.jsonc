{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpcredo",
  "compatibility_date": "2026-09-17",
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
