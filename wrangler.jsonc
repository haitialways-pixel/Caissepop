{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpcredo",
  "compatibility_date": "2026-09-17",
  "preview_urls": true,
  "main": "src/worker.js",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
